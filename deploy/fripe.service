# Installation :
#   sudo cp deploy/fripe.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now fripe
# Journaux : journalctl -u fripe -f

[Unit]
Description=fripe — bot Telegram TikTok vers Vinted
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/fripe
EnvironmentFile=/home/pi/fripe/.env
ExecStart=/home/pi/fripe/.venv/bin/python -m fripe.bot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
