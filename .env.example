# --- Telegram ---------------------------------------------------------------
# Jeton donne par @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=

# --- Claude -----------------------------------------------------------------
# agent_sdk  : utilise ton abonnement Claude (Pro/Max) via le Claude Agent SDK
# anthropic_api : utilise une cle API classique (facturation a l'usage)
LLM_BACKEND=agent_sdk

# Obtenu une seule fois avec la commande : claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Uniquement si LLM_BACKEND=anthropic_api
# ANTHROPIC_API_KEY=

# Modeles utilises
ANALYSIS_MODEL=claude-opus-5
RERANK_MODEL=claude-haiku-4-5

# --- Comportement -----------------------------------------------------------
# Identifiants Telegram autorises, separes par des virgules.
# Vide = tout le monde peut utiliser le bot (deconseille : consomme ton credit).
ALLOWED_CHAT_IDS=

# Nombre d'annonces affichees par vetement (2 a 10)
MAX_RESULTS_PER_GARMENT=6

# Prix maximum en euros pour filtrer les annonces (vide = pas de filtre)
# PRICE_TO=80

# claude (defaut, via l'IA) ou siglip (necessite l'extra [siglip])
RERANKER=claude

DATA_DIR=./data
LOG_LEVEL=INFO
